# /etc/nocturne/api.env  — NON-secret settings for the API EC2. (Copy, edit, chmod 640.)
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://0.0.0.0:5000
App__PublicBaseUrl=https://www.example.com
Auth__RequireConfirmedEmail=true
Auth__SecureCookies=true
Database__AutoMigrate=true
Database__SeedSampleData=true
Storage__RootPath=/var/nocturne/uploads
Reporting__TimeZone=Asia/Manila
Swagger__Enabled=false

# Secrets Manager ids (the instance role only needs secretsmanager:GetSecretValue on these two)
NOCTURNE_DB_SECRET_ID=<RDS-managed-secret-arn>
NOCTURNE_DB_HOST=<rds-endpoint>.rds.amazonaws.com
NOCTURNE_DB_NAME=NocturneCafeDB
NOCTURNE_APP_SECRET_ID=nocturne/app          # JSON: {"AdminEmail":"...","AdminPassword":"...","SmtpPassword":"..."} (optional)

# SMTP (Amazon SES SMTP interface) — required for email verification & password reset in production
Smtp__Host=email-smtp.ap-southeast-1.amazonaws.com
Smtp__Port=587
Smtp__User=<SES SMTP user>
Smtp__From=no-reply@example.com
